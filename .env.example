# ---- 网关监听 ----
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
# 设置后所有 /v1/* 需要 Authorization: Bearer <key>；暴露外网必须设置
GATEWAY_API_KEY=
# ---- 上游行为 ----
# 上游并发硬上限 5，留 1 余量
GATEWAY_MAX_CONCURRENT=4
# 提交重试的总时间上限（秒）。配额按伪造 IP 计（2次/天），身份无限铸造，
# 429 即换身份重试直到成功；超时兜底防死循环
GATEWAY_SUBMIT_TIMEOUT=900
# 任务轮询间隔（秒）
GATEWAY_POLL_INTERVAL=3
# 上游任务执行失败后的自动重投次数（间隔递增，约覆盖 15 分钟抖动窗口）
GATEWAY_TASK_RESUBMITS=8
# 成片缓存目录（上游约 1-2 天回收任务，出片即落盘）
# GATEWAY_VIDEOS_DIR=./videos
# 输入图暂存目录（用于失败重投）
# GATEWAY_UPLOADS_DIR=./uploads
# ---- 代理 ----
# 逗号分隔的 http/socks5 代理池；设置后走代理真实 IP，不再伪造 XFF
PROXY_LIST=
# ---- 存储 ----
# SQLite 任务库路径（默认程序目录下 gateway.db）
GATEWAY_DB=
